# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel > Project > Settings > Environment Variables.
# NEVER prefix these with VITE_ : that would bundle them into the public site.

# Stripe > Developers > API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint page in production
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public site address, no trailing slash
SITE_URL=http://localhost:3000

# EmailJS, for the "payment received" email sent by the webhook
EMAILJS_SERVICE_ID=
EMAILJS_PAYMENT_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
